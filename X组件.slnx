      <Build Solution="*|iPhone" Project="false" />
      <Build Solution="*|iPhoneSimulator" Project="false" />
    </Project>
    <Project Path="XUnitTest.Net6/XUnitTest.Net6.csproj" />
    <Project Path="XUnitTest.SourceGenerator/XUnitTest.SourceGenerator.csproj" />
  </Folder>
  <Project Path="NewLife.Core.Localization.Generator/NewLife.Core.Localization.Generator.csproj" />
  <Project Path="NewLife.Core.SourceGenerator/NewLife.Core.SourceGenerator.csproj" />
