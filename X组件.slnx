<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="iPhone" />
    <Platform Name="iPhoneSimulator" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Others/">
    <File Path=".editorconfig" />
    <File Path=".github/workflows/publish-beta.yml" />
    <File Path=".github/workflows/publish.yml" />
    <File Path=".github/workflows/test.yml" />
    <File Path=".gitignore" />
    <File Path="ChangeLog.md" />
    <File Path="Readme.MD" />
  </Folder>
  <Folder Name="/Samples/">
    <Project Path="Samples/Zero.Desktop/Zero.Desktop.csproj" />
    <Project Path="Samples/Zero.EchoServer/Zero.EchoServer.csproj" />
    <Project Path="Samples/Zero.HttpServer/Zero.HttpServer.csproj" />
